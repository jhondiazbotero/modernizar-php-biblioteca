#!/usr/bin/env bash
# Corre las pruebas de integración (PHP 7.4) contra un MySQL real: solo levanta la base del compose.
# Las opciones de "docker compose run" van como argumentos: bin/integration --build
set -euo pipefail

cd "$(dirname "$0")/.."

if [ ! -d vendor ]; then
    docker run --rm -v "$PWD":/app -w /app --user "$(id -u):$(id -g)" \
        composer:2 install --no-interaction --no-progress --ignore-platform-req=ext-pdo_mysql
fi

export UID
export GID="${GID:-$(id -g)}"

exec docker compose -f docker-compose.yml -f docker-compose.test.yml run --rm "$@" integration
