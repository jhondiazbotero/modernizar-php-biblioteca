#!/usr/bin/env bash
# Corre las pruebas unitarias del código nuevo con PHP 7.4.
# Si falta vendor/ lo instala antes con Composer. Devuelve el código de salida de PHPUnit.
set -euo pipefail

cd "$(dirname "$0")/.."

if [ ! -d vendor ]; then
    docker run --rm -v "$PWD":/app -w /app --user "$(id -u):$(id -g)" \
        composer:2 install --no-interaction --no-progress --ignore-platform-req=ext-pdo_mysql
fi

exec docker run --rm -v "$PWD":/app -w /app --user "$(id -u):$(id -g)" \
    php:7.4.33-cli vendor/bin/phpunit "$@"
