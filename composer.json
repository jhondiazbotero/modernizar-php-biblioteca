{
    "name": "jhondiazbotero/modernizar-php-biblioteca",
    "description": "Aplicación PHP heredada de una biblioteca comunitaria, modernizada por fases",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^7.4 || ^8.4",
        "ext-mysqli": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Library\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Library\\Tests\\": "tests/unit/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        },
        "sort-packages": true
    }
}
