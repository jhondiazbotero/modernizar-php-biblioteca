{
    "name": "jhondiazbotero/modernizar-php-biblioteca",
    "description": "Aplicación PHP heredada de una biblioteca comunitaria, modernizada por fases",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^7.4 || ^8.4",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Library\\": "src/"
        },
        "files": [
            "src/Http/escape.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Library\\Tests\\": "tests/unit/",
            "Library\\Tests\\Integration\\": "tests/integration/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        },
        "sort-packages": true
    }
}
